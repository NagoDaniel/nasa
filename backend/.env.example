# Copy to backend/.env (gitignored) and fill in. All settings use the S2F_ prefix (app/config.py).

# Google Gemini API key for the dashboard assistant. Leave empty to run it in navigation-only mode.
S2F_GEMINI_API_KEY=
# S2F_GEMINI_MODEL=gemini-2.5-flash
# S2F_GEMINI_THINKING_BUDGET=0        # -1 = model default (needed for Pro models)

# Limits (defaults shown)
# S2F_ASSISTANT_MAX_CHARS=500
# S2F_RATE_IP_PER_MIN=6
# S2F_RATE_IP_PER_DAY=60
# S2F_RATE_GLOBAL_LLM_PER_DAY=500
# S2F_LLM_CONCURRENCY=2
# S2F_LLM_TIMEOUT_S=20

# Only behind a reverse proxy you control (otherwise clients could fake their IP):
# S2F_TRUST_FORWARDED_FOR=false
# Fixed HMAC secret for signing replies (random per process when unset):
# S2F_ASSISTANT_SECRET=
